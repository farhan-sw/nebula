<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="axebot">

    <transmission name="wheel_1_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="wheel_1_motor" role="actuator_1"/>
        <joint name="wheel_1_joint" role="joint_1"/>
            <mechanicalReduction>1.0</mechanicalReduction>
        </joint>
    </transmission>

    <transmission name="wheel_2_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="wheel_2_motor" role="actuator_2"/>
        <joint name="wheel_2_joint" role="joint_2"/>
            <mechanicalReduction>1.0</mechanicalReduction>
        </joint>
    </transmission>

    <transmission name="wheel_3_transmission">
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <actuator name="wheel_3_motor" role="actuator_3"/>
        <joint name="wheel_3_joint" role="joint_3"/>
            <mechanicalReduction>1.0</mechanicalReduction>
        </joint>
    </transmission>

    <gazebo reference="chassis_link">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="wheel1_link">
        <material>Gazebo/Grey</material>
        <fdir1>0 1 0"</fdir1>
        <mu1>1.7</mu1> 
        <mu2>0.2</mu2>
    </gazebo>

    <gazebo reference="wheel2_link">
        <material>Gazebo/Grey</material>
        <fdir1>0 1 0"</fdir1>
        <mu1>1.7</mu1> 
        <mu2>0.2</mu2> 
    </gazebo>

    <gazebo reference="wheel3_link">
        <material>Gazebo/Grey</material>
        <fdir1>0 1 0"</fdir1>
        <mu1>1.7</mu1> 
        <mu2>0.2</mu2>
    </gazebo>

</robot>

